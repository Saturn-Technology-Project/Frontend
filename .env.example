# Used by `npm run dev` / `npm run start` on the host.
# Docker Compose sets this to http://api:8000 inside the web container.
API_URL=http://localhost:8000

# Browser and Connector WebSocket origin. Must be the backend public URL, not the
# console. Production example: https://saturn-backend-xxxxx.run.app
# Leave empty locally so the console uses ws://localhost:8000.
# NEXT_PUBLIC_WS_URL=

# Landing site used by the Team registration choice. Local default is
# http://localhost:5173 when the console itself is on localhost.
# NEXT_PUBLIC_LANDING_URL=https://saturn.technology

