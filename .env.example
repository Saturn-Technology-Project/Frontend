# Read by `npm run dev` and `npm run build`. Both are fixed at build time: changing them
# for `npm run start` or on a running container has no effect.

# The console proxies /saturn-api to this origin. There is no local API.
API_URL=https://api.saturn-core.com

# The API's public origin as the browser sees it, not the console's. Shown on the Agents page,
# used for the agent passkey hand-off, and allowed in the Content-Security-Policy.
# (The name is from an earlier version that opened WebSockets; the console opens none now.)
NEXT_PUBLIC_WS_URL=https://api.saturn-core.com

